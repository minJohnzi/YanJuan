# GEMINI_API_KEY: 默认服务端 Gemini 模型密钥（仅站长 OWNER_UIDS 可使用全局密钥）
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# DEEPSEEK_API_KEY: 可选服务端 DeepSeek 模型密钥
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# CUSTOM_OPENAI_*: 可选服务端自定义 OpenAI 兼容接口配置（必须为公网 HTTPS）
CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_BASE_URL="https://api.openai.com/v1"
CUSTOM_OPENAI_MODEL="gpt-4o-mini"

# OWNER_UIDS: 允许使用服务端全局模型密钥的 Firebase UID 列表（逗号分隔）
OWNER_UIDS=""

# CREDENTIAL_ENCRYPTION_KEY: 用于加密存储用户个人 API Key 的 32 字节密钥（64位十六进制或 Base64）
CREDENTIAL_ENCRYPTION_KEY=""

# FIREBASE_*: 可选客户端与服务端 Firebase 配置（未配置时自动降级为访客本地模式）
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# APP_URL: 应用运行地址
APP_URL="http://localhost:3000"

