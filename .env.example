# Runtime Server & Google AI Studio Single-Container Port
PORT=3000
APP_URL="http://localhost:3000"

# Google AI Studio / Server-Side Gemini Virtual Connection (read-only server-env)
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

# Optional PIN protection for server-env GEMINI_API_KEY (client passes X-Server-AI-Pin)
SERVER_AI_ACCESS_PIN=""

# Local-First SQLite Storage & AES-256-GCM Secret (32-byte hex/base64 optional)
SQLITE_DB_PATH=".yanjuan/yanjuan.sqlite"
AI_KEY_ENCRYPTION_SECRET=""
CREDENTIAL_ENCRYPTION_KEY=""

# Optional Additional Provider Keys
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
CUSTOM_OPENAI_API_KEY=""
CUSTOM_OPENAI_BASE_URL="https://api.openai.com/v1"
CUSTOM_OPENAI_MODEL="gpt-4o-mini"
